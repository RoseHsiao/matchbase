# Copy to .env.local (git-ignored). Never commit real values.

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Pooled connection for the application (server only).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection for the Prisma CLI (migrations, seed).
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=require

# --- Sportradar Tennis (live provider; server only, never NEXT_PUBLIC_) ------
# Required to sync the "Sportradar Tennis" data source. Without it the provider
# reports "not configured" and a Sync now records a FAILED run; nothing is faked.
SPORTRADAR_API_KEY=
# trial | production (must match the key)
SPORTRADAR_TENNIS_ACCESS_LEVEL=trial
SPORTRADAR_TENNIS_BASE_URL=https://api.sportradar.com/tennis
SPORTRADAR_TENNIS_LANGUAGE=en
# Season year to sync; defaults to the year of the run.
SPORTRADAR_TENNIS_SEASON_YEAR=
# Comma-separated competition levels (grand_slam, atp_1000, wta_1000, ...).
SPORTRADAR_TENNIS_LEVELS=grand_slam
# Comma-separated competition ids; when set, levels are ignored.
SPORTRADAR_TENNIS_COMPETITIONS=
# Minimum gap between requests in milliseconds (trial keys: about 1 request/second).
SPORTRADAR_TENNIS_REQUEST_INTERVAL_MS=1100

# --- Diagnostics -----------------------------------------------------------
# PRISMA_QUERY_LOG=1
