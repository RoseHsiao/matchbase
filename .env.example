# Copy to .env.local (git-ignored). Never commit real values.

# --- Database (Neon PostgreSQL) ---------------------------------------------
# Use sslmode=verify-full. node-postgres 8.16+ already treats "require" as
# verify-full but logs a SECURITY WARNING at startup when it sees "require".
# Pooled connection for the application (server only).
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Direct connection for the Prisma CLI (migrations, seed).
DATABASE_URL_UNPOOLED=postgresql://user:password@host.region.aws.neon.tech/neondb?sslmode=verify-full

# --- Sportradar Tennis (live provider; server only, never NEXT_PUBLIC_) ------
# Required to sync the "Sportradar Tennis" data source. Without it the provider
# reports "not configured" and a Sync now records a FAILED run; nothing is faked.
SPORTRADAR_API_KEY=
# trial | production (must match the key)
SPORTRADAR_TENNIS_ACCESS_LEVEL=trial
SPORTRADAR_TENNIS_BASE_URL=https://api.sportradar.com/tennis
SPORTRADAR_TENNIS_LANGUAGE=en
# Season year to sync; defaults to the year of the run.
SPORTRADAR_TENNIS_SEASON_YEAR=
# Comma-separated competition levels (grand_slam, atp_1000, wta_1000, ...).
SPORTRADAR_TENNIS_LEVELS=grand_slam
# Comma-separated competition ids; when set, levels are ignored.
SPORTRADAR_TENNIS_COMPETITIONS=
# Minimum gap between requests in milliseconds (trial keys: about 1 request/second).
SPORTRADAR_TENNIS_REQUEST_INTERVAL_MS=1100

# --- TheSportsDB V1 (live provider; server only, never NEXT_PUBLIC_) --------
# The public free key "123" is the default; set a key only if you have one.
# Free tier: 30 requests/minute and truncated listings (teams 10, season 15,
# day 3, next/previous 1). Defaults keep a run at 24 requests/minute and at
# most 28 requests. The bound league (4328, English Premier League) lives in
# lib/data/sync/providers/registry.ts.
# THESPORTSDB_API_KEY=123
# THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
# THESPORTSDB_REQUEST_INTERVAL_MS=2500
# THESPORTSDB_PAST_DAYS=2
# THESPORTSDB_FUTURE_DAYS=7
# THESPORTSDB_MAX_REQUESTS=28
# Season string to sync, e.g. 2026-2027; defaults to the league's current season.
# THESPORTSDB_SEASON=

# --- Authentication (Better Auth; server only) --------------------------------
# Signs session cookies and hashes tokens. Random, at least 32 characters,
# different per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of this deployment. Leave unset locally (inferred from the
# request). On Vercel it is derived from VERCEL_PROJECT_PRODUCTION_URL in
# Production and VERCEL_URL in Preview; set it explicitly for a custom domain.
# BETTER_AUTH_URL=https://matchbase.example.com
# Set to false to close public sign-up (existing accounts keep signing in).
# AUTH_ALLOW_SIGN_UP=true

# --- Local development quick sign-in (optional; never in Production or Preview)
# Adds two buttons to /sign-in that sign in through the normal Better Auth
# path as a development USER and a development ADMIN. The feature refuses to
# activate unless VERCEL_ENV/NODE_ENV say development, the flag is true and
# all four values are set (passwords 10 to 128 characters). The accounts are
# created in the development database on first use; put real values only in
# .env.local.
# MATCHBASE_DEV_LOGIN=true
# MATCHBASE_DEV_USER_EMAIL=dev-user@matchbase.local
# MATCHBASE_DEV_USER_PASSWORD=
# MATCHBASE_DEV_ADMIN_EMAIL=dev-admin@matchbase.local
# MATCHBASE_DEV_ADMIN_PASSWORD=

# --- Deployment environment ---------------------------------------------------
# Vercel sets VERCEL_ENV to production | preview | development. Preview
# deployments refuse provider syncs (cron and Admin "Sync now") unless this is
# set, and then only on a preview that has its own database branch.
# ALLOW_PREVIEW_PROVIDER_SYNC=false

# --- Scheduled sync (Vercel Cron → /api/cron/sync) ---------------------------
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" on every cron
# invocation; the route refuses to run without it. Use a random string of at
# least 16 characters (never commit a real one). Locally, put a value in
# .env.local and call the route with the same header to smoke-test.
CRON_SECRET=
# Cadence tuning (minutes). Defaults match the daily schedule in vercel.json:
# expected interval 1440, freshness grace 180, minimum gap between successful
# runs 30, per-invocation time budget 4, stale RUNNING lock 15.
# SYNC_EXPECTED_INTERVAL_MINUTES=1440
# SYNC_FRESHNESS_GRACE_MINUTES=180
# SYNC_MIN_INTERVAL_MINUTES=30
# SYNC_TIME_BUDGET_MINUTES=4
# SYNC_STALE_LOCK_MINUTES=15

# --- Demo data (prisma db seed) ---------------------------------------------
# The seed lays the demo timeline over the current date (floored to the half
# hour). Set an anchor to reproduce a specific demo state, e.g. for debugging:
#   2026-09-14            -> that day at 12:00 Asia/Taipei
#   2026-09-14T19:30      -> that wall-clock time in Asia/Taipei
#   2026-09-14T04:00:00Z  -> that exact instant
# DEMO_ANCHOR=

# --- Diagnostics -----------------------------------------------------------
# PRISMA_QUERY_LOG=1
